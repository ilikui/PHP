{
  "name": "ilikui/php-learning-oop",
  "description": "PHP OOP, namespaces, Composer autoloading and PHPUnit learning examples",
  "type": "project",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "Learning\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Learning\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit"
  }
}
